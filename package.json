{
  "name": "bri-deep-cleaning-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard Monitoring Deep Cleaning BRI Regional Office 12 Surabaya",
  "engines": { "node": ">=18.17" },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "compression": "^1.7.5",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "framer-motion": "^11.15.0",
    "google-auth-library": "^9.15.0",
    "lucide-react": "^0.469.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "vite": "^5.4.11"
  }
}
